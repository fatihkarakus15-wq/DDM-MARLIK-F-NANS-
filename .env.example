# Supabase "Transaction pooler" bağlantı adresi (6543) ya da herhangi bir PostgreSQL
DATABASE_URL=
# Oturum imzası için uzun rastgele metin (en az 16 karakter)
JWT_SECRET=
# İlk kurulum anahtarı (en az 12 karakter): tabloları kurmak ve ilk hesabı açmak için /kurulum ekranında istenir
SETUP_KEY=

# Zamanlayıcı (Vercel cron) yetkisi: Vercel tanımlı CRON_SECRET'ı kendisi ekler. İsteğe bağlı elle çağrı için.
CRON_SECRET=
# Döviz / altın kaynağı adresleri (isteğe bağlı; boşsa varsayılan)
FX_HAREM_URL=
FX_TCMB_URL=
